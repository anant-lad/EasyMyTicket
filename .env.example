# ── EasyMyTicket v2 — Environment Variables ──────────────────────────────────
# Copy to .env for local development.
# In production (EKS), use AWS Secrets Manager + K8s ConfigMap.

# ── Database (RDS on AWS, or localhost for dev) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickets_db
DB_USER=ticketing_admin
DB_PASSWORD=your_db_password_here
DB_SSL_MODE=disable          # use 'require' on RDS
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── LLM Providers ────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...

# Models
METADATA_EXTRACTION_MODEL=llama-3.1-8b-instant
CLASSIFICATION_MODEL=llama-3.3-70b-versatile

# ── Redis (ElastiCache on AWS, or localhost for dev) ──────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_AUTH=
REDIS_SSL=false
REDIS_ENABLED=false

# ── AWS (SQS/Secrets Manager) ─────────────────────────────────────────────────
AWS_REGION=ap-south-1
SQS_NOTIFICATION_URL=
SQS_LLM_URL=
SQS_ENABLED=false

# ── Email ─────────────────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@yourcompany.com
SUPPORT_EMAIL_APP_PASSWORD=your_gmail_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# ── API Auth (leave empty to disable in dev) ──────────────────────────────────
API_KEYS=

# ── App ───────────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRETS_MANAGER_PREFIX=/ticketing/prod
